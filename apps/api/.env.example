NODE_ENV=development
PORT=3001

DATABASE_URL=postgresql://archlens:archlens@localhost:5433/archlens?schema=public
# Required for Neon/Supabase pooled apps. Local Docker: leave unset/commented.
# DIRECT_DATABASE_URL=

# Neon tip: use migrate:neon (WebSocket/443) when TCP 5432 is blocked by EDR.
REDIS_URL=redis://localhost:6379

JWT_ACCESS_SECRET=change-me-access-secret-min-16-chars
JWT_REFRESH_SECRET=change-me-refresh-secret-min-16-chars
JWT_ACCESS_TTL=900
JWT_REFRESH_TTL=2592000

# Create a GitHub OAuth App — never commit real credentials
GITHUB_CLIENT_ID=your-github-oauth-client-id
GITHUB_CLIENT_SECRET=your-github-oauth-client-secret
GITHUB_CALLBACK_URL=http://localhost:3001/auth/github/callback

WEB_APP_URL=http://localhost:3000

# Optional — Azure OpenAI for post-scan fix suggestions only
# AZURE_OPENAI_ENDPOINT=
# AZURE_OPENAI_API_KEY=
# AZURE_OPENAI_API_VERSION=2024-12-01-preview
# AZURE_OPENAI_DEPLOYMENT_NAME=gpt-4o
# LLM_MAX_OUTPUT_TOKENS=800
